#!/usr/bin/env python3
"""
Tests the ACTUAL bno055_dual_imu.py classes/functions (not a re-implementation)
by faking out the hardware-only modules (board, busio, adafruit_bno055) before
importing it. This runs the real retry logic, real calibration-throttling
logic, and real CSV writer against a fake sensor object.

Run from the same directory as bno055_dual_imu.py.
"""

import sys
import types
import math
import csv
import os
import tempfile
import shutil

# ---------------------------------------------------------------------
# 1. Build fake 'board', 'busio', 'adafruit_bno055' modules and register
#    them in sys.modules BEFORE importing the real script. This lets the
#    real bno055_dual_imu.py import cleanly with zero real hardware.
# ---------------------------------------------------------------------

fake_board = types.ModuleType("board")
fake_board.SCL = "SCL"
fake_board.SDA = "SDA"

fake_busio = types.ModuleType("busio")
class _FakeI2C:
    def __init__(self, scl, sda, frequency=100000):
        self.frequency = frequency
fake_busio.I2C = _FakeI2C

fake_adafruit_bno055 = types.ModuleType("adafruit_bno055")
fake_adafruit_bno055.NDOF_MODE = 0x0C


class FakeBNO055_I2C:
    """
    Stands in for adafruit_bno055.BNO055_I2C. Lets a test script control
    exactly what .euler and .calibration_status return, and inject
    transient OSErrors to exercise the real retry logic.
    """
    raise_on_init = None  # class-level switch: set to an Exception class
                           # (e.g. RuntimeError) to simulate a bad chip ID

    def __init__(self, i2c, address=0x28):
        if FakeBNO055_I2C.raise_on_init is not None:
            exc_type = FakeBNO055_I2C.raise_on_init
            raise exc_type("simulated bad chip id (0x00 != 0xA0)")
        self.address = address
        self.mode = fake_adafruit_bno055.NDOF_MODE
        self.calibrated = False
        self._euler_value = (123.45, 1.23, -4.56)  # heading, roll, pitch
        self._calibration_value = (3, 3, 3, 2)
        self._fail_next_n_reads = 0
        self.euler_read_count = 0
        self.calibration_read_count = 0

    @property
    def euler(self):
        self.euler_read_count += 1
        if self._fail_next_n_reads > 0:
            self._fail_next_n_reads -= 1
            raise OSError("simulated transient I2C bus error")
        return self._euler_value

    @property
    def calibration_status(self):
        self.calibration_read_count += 1
        return self._calibration_value


fake_adafruit_bno055.BNO055_I2C = FakeBNO055_I2C

sys.modules["board"] = fake_board
sys.modules["busio"] = fake_busio
sys.modules["adafruit_bno055"] = fake_adafruit_bno055

# ---------------------------------------------------------------------
# 2. NOW import the real script — it thinks it has real hardware modules.
# ---------------------------------------------------------------------
import bno055_dual_imu as imu_mod  # noqa: E402


def check(label, condition):
    status = "PASS" if condition else "FAIL"
    print(f"  [{status}] {label}")
    if not condition:
        raise AssertionError(label)


def test_basic_reading():
    print("\n-- test_basic_reading --")
    i2c = fake_busio.I2C(fake_board.SCL, fake_board.SDA)
    sensor = imu_mod.BNO055Sensor(i2c, 0x28, name="IMU-TEST")

    check("sensor connects successfully", sensor.connected is True)

    data = sensor.read_orientation()
    check("read_orientation returns a dict", data is not None)
    check("heading maps to yaw_deg correctly", data["yaw_deg"] == 123.45)
    check("roll_deg correct", data["roll_deg"] == 1.23)
    check("pitch_deg correct", data["pitch_deg"] == -4.56)
    check("address cached as hex string", data["address"] == "0x28")


def test_retry_recovers_from_transient_error():
    print("\n-- test_retry_recovers_from_transient_error --")
    i2c = fake_busio.I2C(fake_board.SCL, fake_board.SDA)
    sensor = imu_mod.BNO055Sensor(i2c, 0x28, name="IMU-RETRY")

    # Fail exactly once — should still succeed because READ_RETRIES >= 1
    sensor.sensor._fail_next_n_reads = 1
    data = sensor.read_orientation()
    check("read succeeds after 1 transient failure (retry worked)",
          data is not None)


def test_retry_gives_up_after_max_failures():
    print("\n-- test_retry_gives_up_after_max_failures --")
    i2c = fake_busio.I2C(fake_board.SCL, fake_board.SDA)
    sensor = imu_mod.BNO055Sensor(i2c, 0x28, name="IMU-FAIL")

    # Fail more times than READ_RETRIES allows -> should return None cleanly
    sensor.sensor._fail_next_n_reads = imu_mod.READ_RETRIES + 5
    data = sensor.read_orientation()
    check("read_orientation returns None (no crash) after exhausting retries",
          data is None)


def test_calibration_throttling():
    print("\n-- test_calibration_throttling --")
    i2c = fake_busio.I2C(fake_board.SCL, fake_board.SDA)
    sensor = imu_mod.BNO055Sensor(i2c, 0x28, name="IMU-CAL")

    n_cycles = imu_mod.CALIBRATION_READ_EVERY_N_CYCLES * 3
    for _ in range(n_cycles):
        sensor.read_orientation()

    # should_read_calibration fires on cycle 1, then every Nth cycle
    # (10, 20, 30, ...). Over 30 cycles with N=10 that's cycles
    # {1, 10, 20, 30} -> 4 reads.
    n = imu_mod.CALIBRATION_READ_EVERY_N_CYCLES
    expected_calibration_reads = 1 + n_cycles // n
    check(
        f"calibration_status read only ~every "
        f"{imu_mod.CALIBRATION_READ_EVERY_N_CYCLES} cycles "
        f"({sensor.sensor.calibration_read_count} reads over {n_cycles} cycles, "
        f"expected {expected_calibration_reads})",
        sensor.sensor.calibration_read_count == expected_calibration_reads,
    )
    check(
        "euler WAS read every single cycle (not throttled)",
        sensor.sensor.euler_read_count == n_cycles,
    )


def test_is_calibrated_uses_library_property():
    print("\n-- test_is_calibrated_uses_library_property --")
    i2c = fake_busio.I2C(fake_board.SCL, fake_board.SDA)
    sensor = imu_mod.BNO055Sensor(i2c, 0x28, name="IMU-BOOL")

    sensor.sensor.calibrated = False
    check("is_calibrated() False before calibration", sensor.is_calibrated() is False)

    sensor.sensor.calibrated = True
    check("is_calibrated() True after calibration", sensor.is_calibrated() is True)


def test_csv_logging():
    print("\n-- test_csv_logging --")
    tmpdir = tempfile.mkdtemp()
    try:
        csv_path = os.path.join(tmpdir, "test_log.csv")
        f, writer = imu_mod.init_csv_log(csv_path)

        check("CSV file created", os.path.isfile(csv_path))

        sample = {
            "name": "IMU-1", "address": "0x28",
            "roll_deg": 1.11, "pitch_deg": -2.22, "yaw_deg": 300.5,
            "calibration": {"system": 3, "gyro": 3, "accel": 3, "mag": 2},
        }
        imu_mod.log_reading_to_csv(writer, sample)
        imu_mod.log_reading_to_csv(writer, None)  # should be silently skipped
        f.close()

        with open(csv_path, newline="") as rf:
            rows = list(csv.reader(rf))

        check("header row written", rows[0] == imu_mod.CSV_COLUMNS)
        check("exactly one data row (None reading was skipped)", len(rows) == 2)
        check("row data matches input", rows[1][1:] == [
            "IMU-1", "0x28", "1.11", "-2.22", "300.5", "3", "3", "3", "2"
        ])
        print(f"  Sample CSV row: {rows[1]}")
    finally:
        shutil.rmtree(tmpdir)


def test_runtime_error_on_bad_chip_id_is_caught():
    """
    Regression test for the real bug found on final review: the actual
    adafruit_bno055 library raises RuntimeError (not OSError/ValueError)
    when the chip ID doesn't match BNO055. Before the fix, this crashed
    the whole script instead of marking the sensor as disconnected.
    """
    print("\n-- test_runtime_error_on_bad_chip_id_is_caught --")
    i2c = fake_busio.I2C(fake_board.SCL, fake_board.SDA)

    FakeBNO055_I2C.raise_on_init = RuntimeError
    try:
        sensor = imu_mod.BNO055Sensor(i2c, 0x28, name="IMU-BADCHIP")
        check("RuntimeError on bad chip ID is caught, not raised",
              True)  # if we get here without an exception, it's caught
        check("sensor.connected is False after a bad chip ID",
              sensor.connected is False)
        check("read_orientation() returns None cleanly, doesn't crash",
              sensor.read_orientation() is None)
    finally:
        FakeBNO055_I2C.raise_on_init = None  # reset for other tests


def test_zero_config_values_are_rejected():
    print("\n-- test_zero_config_values_are_rejected --")
    original = imu_mod.PRINT_EVERY_N_CYCLES
    try:
        imu_mod.PRINT_EVERY_N_CYCLES = 0
        try:
            imu_mod.main()
            check("main() exits instead of raising ZeroDivisionError", False)
        except SystemExit as e:
            check("main() exits cleanly (sys.exit) on invalid config, "
                  "no ZeroDivisionError", e.code == 1)
    finally:
        imu_mod.PRINT_EVERY_N_CYCLES = original


def test_quaternion_math_unchanged():
    print("\n-- test_quaternion_math_unchanged --")
    r, p, y = imu_mod.quaternion_to_euler(1, 0, 0, 0)
    check("identity quaternion -> (0,0,0)",
          abs(r) < 1e-6 and abs(p) < 1e-6 and abs(y) < 1e-6)


if __name__ == "__main__":
    test_basic_reading()
    test_retry_recovers_from_transient_error()
    test_retry_gives_up_after_max_failures()
    test_calibration_throttling()
    test_is_calibrated_uses_library_property()
    test_csv_logging()
    test_runtime_error_on_bad_chip_id_is_caught()
    test_zero_config_values_are_rejected()
    test_quaternion_math_unchanged()
    print("\nAll tests passed against the REAL bno055_dual_imu.py logic.\n")
