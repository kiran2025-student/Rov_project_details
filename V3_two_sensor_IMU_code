#include <Wire.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BNO055.h>
#include <utility/imumaths.h>

// Initialize two BNO055 instances with distinct I2C addresses
Adafruit_BNO055 bno1 = Adafruit_BNO055(55, 0x28); // Sensor 1 (ADR to GND)
Adafruit_BNO055 bno2 = Adafruit_BNO055(56, 0x29); // Sensor 2 (ADR to 3.3V)

// Telemetry structures
struct SensorData {
  float heading;
  float roll;
  float pitch;
  String headingDir;
  String rollDir;
  String pitchDir;
};

SensorData sensor1;
SensorData sensor2;

int readCount = 0;

// Function Prototypes
void readSensors();
void calculateDirections(SensorData &data);
void printTelemetry(const String &name, const SensorData &data);
void printCSV();

void setup()
{
  Serial.begin(9600);
  while (!Serial && millis() < 4000); // Wait for Serial monitor on USB boards

  Serial.println("=================================");
  Serial.println("   DUAL BNO055 ORIENTATION SYSTEM");
  Serial.println("=================================");

  // Initialize Sensor 1 (0x28)
  if (!bno1.begin())
  {
    Serial.println("ERROR: Sensor 1 (0x28) not detected! Check wiring/ADR pin.");
    while (1);
  }

  // Initialize Sensor 2 (0x29)
  if (!bno2.begin())
  {
    Serial.println("ERROR: Sensor 2 (0x29) not detected! Check wiring/ADR pin.");
    while (1);
  }

  delay(1000);

  // Enable external crystal on both units for better precision
  bno1.setExtCrystalUse(true);
  bno2.setExtCrystalUse(true);

  Serial.println("Both BNO055 Sensors Initialized Successfully!");
  Serial.println();
}

void loop()
{
  readSensors();

  calculateDirections(sensor1);
  calculateDirections(sensor2);

  // Print individual telemetry blocks
  printTelemetry("SENSOR 1 (0x28)", sensor1);
  printTelemetry("SENSOR 2 (0x29)", sensor2);

  // Print combined CSV row
  printCSV();

  delay(1000); // Adjust polling rate as needed
}

// Read raw orientation vectors from both devices
void readSensors()
{
  sensors_event_t event1, event2;

  bno1.getEvent(&event1);
  sensor1.heading = event1.orientation.x;
  sensor1.roll    = event1.orientation.y;
  sensor1.pitch   = event1.orientation.z;

  bno2.getEvent(&event2);
  sensor2.heading = event2.orientation.x;
  sensor2.roll    = event2.orientation.y;
  sensor2.pitch   = event2.orientation.z;
}

// Direction processing helper (applied to any SensorData instance)
void calculateDirections(SensorData &data)
{
  // Heading / Compass Direction
  if (data.heading >= 337.5 || data.heading < 22.5)
    data.headingDir = "North";
  else if (data.heading < 67.5)
    data.headingDir = "North-East";
  else if (data.heading < 112.5)
    data.headingDir = "East";
  else if (data.heading < 157.5)
    data.headingDir = "South-East";
  else if (data.heading < 202.5)
    data.headingDir = "South";
  else if (data.heading < 247.5)
    data.headingDir = "South-West";
  else if (data.heading < 292.5)
    data.headingDir = "West";
  else
    data.headingDir = "North-West";

  // Roll Status
  if (data.roll > 5.0)
    data.rollDir = "Right Roll";
  else if (data.roll < -5.0)
    data.rollDir = "Left Roll";
  else
    data.rollDir = "Level";

  // Pitch Status
  if (data.pitch > 5.0)
    data.pitchDir = "Nose Up";
  else if (data.pitch < -5.0)
    data.pitchDir = "Nose Down";
  else
    data.pitchDir = "Level";
}

// Formatted Telemetry Print
void printTelemetry(const String &name, const SensorData &data)
{
  Serial.print("---------------------------------\n");
  Serial.print("        "); Serial.println(name);
  Serial.print("---------------------------------\n");

  Serial.print("Heading : ");
  Serial.print(data.heading, 1);
  Serial.print("° (");
  Serial.print(data.headingDir);
  Serial.println(")");

  Serial.print("Roll    : ");
  Serial.print(data.roll, 1);
  Serial.print("° (");
  Serial.print(data.rollDir);
  Serial.println(")");

  Serial.print("Pitch   : ");
  Serial.print(data.pitch, 1);
  Serial.print("° (");
  Serial.print(data.pitchDir);
  Serial.println(")");
}

// Combined CSV Log Output
void printCSV()
{
  Serial.println("\n--- CSV Output [H1,R1,P1,H2,R2,P2] ---");
  Serial.print(sensor1.heading, 2); Serial.print(",");
  Serial.print(sensor1.roll, 2);    Serial.print(",");
  Serial.print(sensor1.pitch, 2);   Serial.print(",");
  Serial.print(sensor2.heading, 2); Serial.print(",");
  Serial.print(sensor2.roll, 2);    Serial.print(",");
  Serial.println(sensor2.pitch, 2);
  Serial.println("=================================\n");
}
